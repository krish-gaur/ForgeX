# ─────────────────────────────────────────────────────────────────────────────
# ForgeX backend configuration — copy to `backend/.env` and adjust.
# Every value below shows the effective DEFAULT; unset vars fall back to it.
# ─────────────────────────────────────────────────────────────────────────────

# -- app ----------------------------------------------------------------------
ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO
# Where the SQLite file / uploads / sandbox temp files live (defaults: backend/data)
# DATA_DIR=/var/lib/forgex/data
# FILE_STORE_DIR=/var/lib/forgex/data/files
# Forensic dataset vault (defaults: <repo>/datasets)
# DATASET_DIR=/srv/forgex/datasets
# Forensic function templates (defaults: backend/templates)
# TEMPLATE_DIR=/srv/forgex/backend/templates

# -- security -----------------------------------------------------------------
# REQUIRED in production (>= 32 chars). Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated browser origins allowed to call the API directly.
# (The bundled Next.js frontend proxies same-origin, so defaults are fine.)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY=false                # set true behind nginx to honor X-Forwarded-For

# -- database -----------------------------------------------------------------
# Default: local SQLite (zero-setup). For production use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://forgex:forgex@localhost:5432/forgex
DATABASE_URL=sqlite+aiosqlite:///data/forgex.db
AUTO_CREATE_SCHEMA=true            # dev convenience; Alembic is canonical (alembic upgrade head)

# -- execution pipeline ---------------------------------------------------------
COLLECTOR_TIMEOUT_SEC=30
SCRIPT_TIMEOUT_SEC=30
TASK_BACKEND=inline                # inline (asyncio, default) | celery
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
MAX_CONCURRENT_JOBS=3

# -- correlation graph / vector search ------------------------------------------
GRAPH_STORE=sql                    # sql (default, works everywhere) | neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
EMBEDDING_PROVIDER=local           # local (deterministic hashing embeddings, no network) | openai
EMBEDDING_DIM=256

# -- AI ("what happened?" + Q&A) -------------------------------------------------
# auto = use Anthropic key if present, else OpenAI key, else the built-in
# deterministic evidence-citing heuristic engine (never fabricates evidence).
LLM_PROVIDER=auto                  # auto | anthropic | openai | off
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_ANTHROPIC=claude-sonnet-4-6
LLM_MODEL_OPENAI=gpt-4o
LLM_TIMEOUT_SEC=45

# -- blockchain anchoring ---------------------------------------------------------
# local = append-only SHA-256 hash-chain ledger (default, offline).
# sepolia = additionally anchor evidence-batch roots to the Sepolia testnet.
BLOCKCHAIN_ANCHOR=local            # local | sepolia
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# -- rate limits --------------------------------------------------------------------
RATE_LIMIT_API_PER_MIN=100
RATE_LIMIT_FQL_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_MIN=10

# -- demo ----------------------------------------------------------------------------
# Seed the deterministic DEMO-Corp-Breach-2026 case (SYNTHETIC data) on first boot.
DEMO_SEED_ON_BOOT=false
